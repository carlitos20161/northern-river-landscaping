{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Untitled document (1).docx"
    ],
    "redirects": [
      {
        "source": "/towns/upper-saddle-river.html",
        "destination": "/upper-saddle-river-landscaping.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/upper-saddle-river-landscaping",
        "destination": "/upper-saddle-river-landscaping.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|ico|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
